{{!-- Adventure Journal Builder — main layout --}}
<div class="dajb-layout">

  {{!-- Toolbar --}}
  <div class="dajb-toolbar">
    <div class="dajb-toolbar-left">
      <button type="button" data-action="load-pdf" class="dajb-btn">
        <i class="fas fa-file-pdf"></i>
        {{#if pdfLoaded}}Change PDF{{else}}Load PDF{{/if}}
      </button>
      <span id="dajb-pdf-status" class="dajb-pdf-status">
        {{#if pdfLoaded}}
          {{pdfFileName}} ({{pdfPages}} pages)
        {{else}}
          No PDF loaded
        {{/if}}
      </span>
    </div>
    <div class="dajb-toolbar-right">
      <button type="button" data-action="load-rules" class="dajb-btn" title="Load rules from JSON file">
        <i class="fas fa-folder-open"></i> Load Rules
      </button>
      <button type="button" data-action="save-rules" class="dajb-btn" title="Save rules to JSON file">
        <i class="fas fa-save"></i> Save Rules
      </button>
      <button type="button" data-action="build-journal" class="dajb-btn dajb-btn-primary" title="Parse PDF and create journal entries">
        <i class="fas fa-hammer"></i> Build Journal
      </button>
    </div>
  </div>

  {{!-- Three-panel body --}}
  <div class="dajb-panels">

    {{!-- Left: Rules Tree --}}
    <div class="dajb-rules-panel">
      <div class="panel-header">
        <span>Rules</span>
        <button type="button" data-action="add-top-rule" title="Add top-level section rule" class="dajb-icon-btn">
          <i class="fas fa-plus"></i>
        </button>
      </div>
      <div class="dajb-rules-tree" id="dajb-rules-tree">
        {{!-- dynamically populated by BuilderApp._renderRulesTree() --}}
      </div>
    </div>

    {{!-- Center: Rule Editor --}}
    <div class="dajb-editor-panel" id="dajb-editor-panel">
      <div class="dajb-no-selection">
        <i class="fas fa-arrow-left"></i>
        Select a rule to edit
      </div>
    </div>

    {{!-- Right: Live Preview / Select Regions tabs --}}
    <div class="dajb-preview-panel">
      <div class="panel-header dajb-preview-tabbar">
        <button type="button" class="dajb-preview-tab active" data-tab="preview">Live Preview</button>
        <button type="button" class="dajb-preview-tab" data-tab="regions">Select Regions</button>
      </div>

      {{!-- Live Preview tab --}}
      <div class="dajb-tab-content" data-tab="preview">
        <div class="dajb-preview-content" id="dajb-preview-content">
          Load a PDF and select a rule to see matches.
        </div>
      </div>

      {{!-- Select Regions tab --}}
      <div class="dajb-tab-content dajb-region-tab" data-tab="regions" id="dajb-tab-regions" hidden>
        <div class="dajb-region-bar">
          <div class="dajb-region-tools">
            <button type="button" class="dajb-rtool dajb-rtool-alt" data-region-action="toggle-alternating" title="Alternating pages — split Default into A/B so left/right spread pages can use different margins. The first page in range is A, the next B, then alternating.">
              ⇄ A/B
            </button>
            <button type="button" class="dajb-rtool dajb-rtool-default" data-region-action="tool-default" title="Default region — applied at the same coordinates on every page in range. Draw multiple (e.g. columns); text is stitched in draw order.">
              <span class="dajb-rtool-swatch"></span> <span class="dajb-rtool-label">Default</span>
            </button>
            <button type="button" class="dajb-rtool dajb-rtool-defaultB" data-region-action="tool-defaultB" title="Default B — applies to alternating (B) pages only. Draw the margins for the opposite side of the spread here." hidden>
              <span class="dajb-rtool-swatch"></span> Default B
            </button>
            <button type="button" class="dajb-rtool dajb-rtool-exclusion" data-region-action="tool-exclusion" title="Exclusion — carve a section out of the default regions on THIS page only.">
              <span class="dajb-rtool-swatch"></span> Exclusion
            </button>
            <button type="button" class="dajb-rtool dajb-rtool-override" data-region-action="tool-override" title="Override — ignore the default regions on THIS page and use the regions drawn here instead.">
              <span class="dajb-rtool-swatch"></span> Override
            </button>
            <button type="button" class="dajb-rtool dajb-rtool-table" data-region-action="tool-table" title="Table Override — mark a section of THIS page as a table. Doesn't change the text stream; a Table rule with 'Import Table Regions' uses these to locate tables.">
              <span class="dajb-rtool-swatch"></span> Table
            </button>
            <button type="button" class="dajb-rtool dajb-rtool-edit" data-region-action="tool-edit" title="Edit — click a region to select it, drag its corner handles to resize, or drag its body to move.">
              <span class="dajb-rtool-swatch"></span> Edit
            </button>
          </div>
          <div class="dajb-region-nav">
            <button type="button" data-region-action="zoom-out" title="Zoom out">−</button>
            <span class="dajb-region-zoomlabel" title="Zoom (relative to fit)">100%</span>
            <button type="button" data-region-action="zoom-in" title="Zoom in">+</button>
            <button type="button" data-region-action="zoom-fit" title="Fit to width">Fit</button>
            <span class="dajb-region-navsep"></span>
            <button type="button" data-region-action="prev-page" title="Previous page">◀</button>
            <span class="dajb-region-pagelabel"></span>
            <button type="button" data-region-action="next-page" title="Next page">▶</button>
          </div>
        </div>
        <div class="dajb-region-body">
          <div class="dajb-region-canvas-wrap">
            <div class="dajb-region-stage">
              <canvas id="dajb-pdf-canvas" class="dajb-pdf-canvas"></canvas>
              <canvas id="dajb-region-canvas" class="dajb-region-canvas"></canvas>
            </div>
          </div>
          <button type="button" class="dajb-region-collapse" data-region-action="toggle-side" title="Hide region list">⟩</button>
          <div class="dajb-region-side">
            <div class="dajb-region-subtabs">
              <button type="button" class="dajb-region-subtab active" data-region-tab="thispage">This Page</button>
              <button type="button" class="dajb-region-subtab" data-region-tab="exceptions">Exceptions</button>
            </div>
            <div class="dajb-region-list" id="dajb-region-list"></div>
            <div class="dajb-region-exceptions" id="dajb-region-exceptions" hidden></div>
          </div>
        </div>
      </div>
    </div>

  </div>{{!-- /.dajb-panels --}}
</div>{{!-- /.dajb-layout --}}
