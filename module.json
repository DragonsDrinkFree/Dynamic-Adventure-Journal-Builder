{
  "id": "dynamic-adventure-journal-builder",
  "title": "Dynamic Adventure Journal Builder",
  "version": "1.0.0",
  "compatibility": {
    "minimum": "13",
    "verified": "13"
  },
  "authors": [
    {
      "name": "GravyBoat, DragonsDrinkFree",
